{
	"name": "WorkBound",
	"version": "1.0.3",
	"description": "A calm email desktop client.",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:stable": "vite build && electrobun build --env=stable"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.27",
		"@ai-sdk/deepseek": "^3.0.19",
		"@ai-sdk/google": "^4.0.31",
		"@ai-sdk/groq": "^4.0.19",
		"@ai-sdk/mistral": "^4.0.20",
		"@ai-sdk/moonshotai": "^3.0.23",
		"@ai-sdk/openai": "^4.0.27",
		"@ai-sdk/xai": "^4.0.25",
		"@base-ui/react": "^1.6.0",
		"@tabler/icons-react": "^3.44.0",
		"@tanstack/react-virtual": "^3.14.5",
		"ai": "^7.0.48",
		"chrono-node": "^2.10.1",
		"dompurify": "^3.4.11",
		"drizzle-orm": "^1.0.0-rc.4",
		"electrobun": "1.18.1",
		"framer-motion": "^12.42.2",
		"hast-util-to-html": "^9.0.5",
		"html-to-text": "^10.0.0",
		"iconsax-reactjs": "^0.0.8",
		"jotai": "^2.20.1",
		"lucide-react": "^1.22.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-markdown": "^10.1.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.20",
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"drizzle-kit": "^1.0.0-rc.4",
		"postcss": "^8.4.49",
